{
  "name": "chorus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:backend": "convex dev",
    "dev:all": "convex dev --start \"next dev\"",
    "typecheck": "next typegen && tsc --noEmit && tsc --project convex/tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:local": "node scripts/setup-local-convex.mjs",
    "test": "node --test scripts/publish-backlog.test.mjs && vitest run",
    "test:auth:backend": "node --test scripts/auth-backend.test.mjs",
    "backlog:docs": "node scripts/render-backlog.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@tanstack/react-router": "^1.170.45",
    "@tidecloak/js": "0.14.41",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "convex": "^1.47.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "0.0.64",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jose": "6.2.13",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
