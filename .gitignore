# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# checked-in environment template
!.env.example

# local Convex deployment data and credentials
/.convex/

# Private Tide proof requests can contain session-bound approval credentials.
/.policy-proof/

# Demo media for the web demo (personal photos, audio and video). Share these
# through a drive, not git. See public/sample-db/README.md.
/public/sample-db/photos/*
/public/sample-db/videos/*
/public/sample-db/audio/*
/public/sample-db/avatars/*
!/public/sample-db/*/.gitkeep
/public/sample-db/manifest.json
