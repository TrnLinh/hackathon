# Optional for the UI shell. Convex CLI writes real values to .env.local.
# Never put deployment keys or secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_CONVEX_URL=

# Public browser adapter fields. Copy from your TideCloak client adapter.
# Never paste the full adapter, client secrets, or tokens here.
NEXT_PUBLIC_TIDECLOAK_URL=
NEXT_PUBLIC_TIDECLOAK_REALM=
NEXT_PUBLIC_TIDECLOAK_CLIENT_ID=
NEXT_PUBLIC_TIDECLOAK_VENDOR_ID=
NEXT_PUBLIC_TIDECLOAK_HOME_ORK_URL=
NEXT_PUBLIC_TIDECLOAK_CLIENT_ORIGIN_AUTH=

# Configure these on the Convex deployment with `npx convex env set`.
# They are listed here as a reference; Next.js .env.local does not set backend env.
# Issuer example: https://identity.example/realms/chorus (no trailing slash).
TIDECLOAK_ISSUER=
TIDECLOAK_CLIENT_ID=
